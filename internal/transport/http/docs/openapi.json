{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.0.0",
    "description": "CRUD API for tasks and recurring rules built with clean architecture."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    },
    {
      "name": "Recurring Rules",
      "description": "Operations with recurring rules for periodic tasks"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/recurringrule-rules": {
      "get": {
        "tags": ["Recurring Rules"],
        "summary": "List all recurring rules",
        "responses": {
          "200": {
            "description": "List of recurring rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/RecurringRule" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Recurring Rules"],
        "summary": "Create recurring rule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRecurringRuleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created recurring rule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringRule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/recurringrule-rules/{id}": {
      "get": {
        "tags": ["Recurring Rules"],
        "summary": "Get recurring rule by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurring rule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringRule" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Recurring Rules"],
        "summary": "Update recurring rule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateRecurringRuleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated recurring rule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurringRule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Recurring Rules"],
        "summary": "Delete recurring rule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/recurringrule-rules/{id}/status": {
      "patch": {
        "tags": ["Recurring Rules"],
        "summary": "Update recurring rule status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["active", "paused", "archived"],
                    "example": "paused"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Status updated" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Prepare release" },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          }
        }
      },
      "CreateRecurringRuleRequest": {
        "type": "object",
        "required": ["title", "recurrence_type", "config", "start_date"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Daily health check"
          },
          "description": {
            "type": "string",
            "example": "Check system health every day"
          },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "archived"],
            "example": "active"
          },
          "recurrence_type": {
            "type": "string",
            "enum": ["daily", "monthly", "evenodd", "specific"],
            "example": "daily"
          },
          "config": {
            "type": "object",
            "description": "Configuration object depends on recurrence_type",
            "oneOf": [
              {
                "title": "daily",
                "properties": {
                  "interval_days": { "type": "integer", "minimum": 1, "example": 2 }
                }
              },
              {
                "title": "monthly",
                "properties": {
                  "day_of_month": { "type": "integer", "minimum": 1, "maximum": 30, "example": 5 }
                }
              },
              {
                "title": "evenodd",
                "properties": {
                  "parity": { "type": "string", "enum": ["even", "odd"], "example": "even" }
                }
              },
              {
                "title": "specific",
                "properties": {
                  "dates": {
                    "type": "array",
                    "items": { "type": "string", "format": "date-time" },
                    "example": ["2026-04-15T00:00:00Z", "2026-05-01T00:00:00Z"]
                  }
                }
              }
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-12T00:00:00Z"
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-31T00:00:00Z"
          }
        }
      },
      "UpdateRecurringRuleRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Updated daily health check"
          },
          "description": {
            "type": "string",
            "example": "Updated description"
          },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "archived"],
            "example": "paused"
          },
          "recurrence_type": {
            "type": "string",
            "enum": ["daily", "monthly", "evenodd", "specific"],
            "example": "daily"
          },
          "config": {
            "type": "object",
            "description": "Configuration object depends on recurrence_type"
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-01T00:00:00Z"
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-31T00:00:00Z"
          }
        }
      },
      "RecurringRule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Daily health check" },
          "description": { "type": "string", "example": "Check system health every day" },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "archived"],
            "example": "active"
          },
          "recurrence_type": {
            "type": "string",
            "enum": ["daily", "monthly", "evenodd", "specific"],
            "example": "daily"
          },
          "config": {
            "type": "object",
            "description": "Configuration object depends on recurrence_type",
            "example": { "interval_days": 2 }
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-12T00:00:00Z"
          },
          "end_date": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-31T00:00:00Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-12T10:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-12T10:30:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "recurring rule not found" }
        }
      }
    }
  }
}